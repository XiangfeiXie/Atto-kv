    {
      "id": "1r38myRveq2p8I2hJFbXJ",
      "type": "text",
      "x": 1951.753142913062,
      "y": 538.8206720241247,
      "width": 412.3597412109375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
