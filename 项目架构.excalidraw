    {
      "id": "14avOaKf6XabAgbzu81rG",
      "type": "text",
      "x": 6588.422535822923,
      "y": 3815.4329324529435,
      "width": 1580,
      "height": 7550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAb",
      "roundness": null,
      "seed": 440120878,
      "version": 1886,
      "versionNonce": 1820815346,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787465578287,
      "link": null,
      "locked": false,
      "text": "═══════════════════════════════════════════════════════════════════════════════\n                   数据从 Master → Slave 的完整流动与管理\n═══════════════════════════════════════════════════════════════════════════════\n\n【前提：连接建立与资源交换】\n\nMaster                                          Slave\n  │                                               │\n  │ ① rdma_listen() 监听                         │\n  │                                               │\n  │ ② rdma_get_request() 接受连接                │\n  │  ←─────────── rdma_connect() ─────────────── │\n  │                                               │\n  │ ③ rdma_accept()                              │\n  │  ──────────── rdma_accept() ────────────────►│\n  │                                                                                              │\n  │                                                                                              │ ④ 分配环形缓冲池(8个)\n  │                                                                                              │    bufs[0..7] 每个FULLSYNC_BUF_SIZE\n  │                                                                                              │    注册为 RDMA 可写 MR\n  │                                                                                              │\n  │                                                                                              │ ⑤ 构造 buf_info:\n  │                                                                                              │    num_bufs=8\n  │                                                                                              │    addr[0..7] (本地虚拟地址)\n  │                                                                                              │    rkey[0..7]  (远程访问密钥)\n  │                                                                                              │\n  │  ←─────────── RDMA SEND(buf_info) ─────────── │\n  │                                               │\n  │ ⑥ 保存 Slave 的地址和 rkey 数组              │\n  │                                               │\n  │ ⑦ 注册本地 MR (存放待发送数据)               │\n  │                                               │\n  │ ⑧ 创建 ACK 接收槽 (8个)                     │\n  │    每个槽位接收 struct ack_msg               │\n  │    预投递 RECV 请求                          │\n  │                                               │\n  │ ⑨ 初始化空闲缓冲池: free_q=[0,1,2,3,4,5,6,7]│\n  │                                               │\n\n═══════════════════════════════════════════════════════════════════════════════\n\n【传输循环：数据分批发送与 ACK 流控】\n\n┌─────────────────────────────────────────────────────────────────────────────┐\n│                    Master 侧 send_rdb_batches() 主循环                     │\n└─────────────────────────────────────────────────────────────────────────────┘\n\nStep 1: 检查是否有空闲的 Slave 缓冲槽\n         ┌──────────────────────────────────────┐\n         │  while (bp_empty(&bp) && !rs.exhausted) │\n         │  {                                   │\n         │     等待 Slave 的 ACK 回来           │\n         │     poll_recv_ack() → 回收槽位       │\n         │     bp_release(回收的槽位索引)        │\n         │  }                                   │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep 2: 从空闲池获取一个 Slave 缓冲槽\n         ┌──────────────────────────────────────┐\n         │  buf_idx = bp_acquire(&bp)           │\n         │  例如：buf_idx = 2                   │\n         │  从 free_q 取出，count 减 1          │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep 3: 序列化数据到本地 MR buffer\n         ┌──────────────────────────────────────┐\n         │  dst = 本地 MR buffer 地址           │\n         │  *(uint32_t*)dst = 0  (预留长度槽)   │\n         │  off = 4                             │\n         │                                      │\n         │  if (is_first_batch) {              │\n         │     写入 batch_hdr 到 dst+off        │\n         │     off += sizeof(batch_hdr)        │\n         │     is_first_batch = 0              │\n         │  }                                   │\n         │                                      │\n         │  n = rdb_serialize_next(dst+off)     │\n         │  off += n                            │\n         │                                      │\n         │  *(uint32_t*)dst = htonl(off-4)      │\n         │  // 现在本地 MR buffer 包含:         │\n         │  // [4B长度][batch_hdr][RDB entries] │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep 4: RDMA WRITE 将数据推送到 Slave 的指定缓冲槽\n         ┌──────────────────────────────────────────────────────────────┐\n         │  rdma_xport_write(                                         │\n         │      data = 本地 MR buffer,    // 源地址                  │\n         │      len = off,                // 数据长度                 │\n         │      lkey = 本地 MR 的 lkey,   // 本地访问密钥            │\n         │      remote_addr = binfo.addr[buf_idx], // Slave 地址     │\n         │      rkey = binfo.rkey[buf_idx],       // Slave 密钥      │\n         │      imm_data = batch_done ? DONE : 0   // 立即数信号     │\n         │  )                                                        │\n         │                                                            │\n         │  内部自动按 CHUNK_SIZE 拆分：                              │\n         │  ┌──────────────────────────────────────────────────────┐ │\n         │  │ chunk1: WRITE (无信号)  → 不产生 CQE               │ │\n         │  │ chunk2: WRITE (无信号)  → 不产生 CQE               │ │\n         │  │ ...                                                │ │\n         │  │ chunkN: WRITE_WITH_IMM (有信号) → 产生 CQE         │ │\n         │  │         imm_data 附带在最后一个包中                 │ │\n         │  └──────────────────────────────────────────────────────┘ │\n         └──────────────────────────────────────────────────────────────┘\n                    │\n                    ▼\nStep 5: 更新 Master 状态\n         ┌──────────────────────────────────────┐\n         │  total_bytes += off                  │\n         │  ack_inflight += 1    // 等待ACK+1   │\n         │  nr_batch++                          │\n         │                                      │\n         │  if (batch_done) {                  │\n         │      rs.exhausted = 1               │\n         │      记录传输结束时间                │\n         │  }                                   │\n         └──────────────────────────────────────┘\n\n═══════════════════════════════════════════════════════════════════════════════\n\n【并行：Slave 侧接收与处理】\n\nMaster 的 RDMA WRITE 到达 Slave\n         │\n         ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│                    Slave 侧接收循环                                         │\n└─────────────────────────────────────────────────────────────────────────────┘\n\nStep A: 等待 RDMA WRITE 完成通知\n         ┌──────────────────────────────────────┐\n         │  rdma_xport_poll_recv()              │\n         │  轮询 recv_cq 获得 CQE               │\n         │  从 wc.imm_data 获取立即数           │\n         │  确定是哪个 buffer 被写入 (buf_cur)   │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep B: 读取 Slave buffer 中的数据\n         ┌──────────────────────────────────────┐\n         │  cur = buf_cur                      │\n         │  buf_cur = (buf_cur + 1) % 8        │\n         │                                      │\n         │  // 从 buffer 头部读取长度          │\n         │  data_len = ntohl(*(uint32_t*)bufs[cur])│\n         │  // 数据从 bufs[cur] + 4 开始       │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep C: 解析并加载数据到 kvstore\n         ┌──────────────────────────────────────┐\n         │  load_rdb_batch(bufs[cur]+4, data_len)│\n         │                                      │\n         │  if (is_first) {                    │\n         │     解析 batch_hdr                   │\n         │     保存 repl_offset                 │\n         │     kvs_flush_all() 清空旧数据       │\n         │     rdb_load_stream_begin()          │\n         │     dict_reserve() 预分配哈希表      │\n         │     dict_arena_init() 预分配内存     │\n         │     is_first = 0                     │\n         │  }                                   │\n         │                                      │\n         │  rdb_load_stream_append()            │\n         │  解析每条 RDB 记录并插入 g_dict      │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep D: 发送 ACK 给 Master（释放缓冲槽）\n         ┌──────────────────────────────────────┐\n         │  ack_buf.buf_idx = cur              │\n         │  ack_buf.entries = 本批插入条数      │\n         │                                      │\n         │  rdma_post_send(ACK)                 │\n         │  // 通过 RDMA SEND 发送给 Master    │\n         │                                      │\n         │  等待发送完成                         │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep E: 重新投递该 buffer 的 RECV 请求\n         ┌──────────────────────────────────────┐\n         │  重新 ibv_post_recv()               │\n         │  准备接收下一批数据                  │\n         └──────────────────────────────────────┘\n\n═══════════════════════════════════════════════════════════════════════════════\n\n【Master 侧 ACK 处理与缓冲槽回收】\n\nSlave 的 ACK 到达 Master\n         │\n         ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│                    Master 侧 ACK 处理                                       │\n└─────────────────────────────────────────────────────────────────────────────┘\n\nStep X: poll_recv_ack() 被调用（在 Step 1 的等待循环中）\n         ┌──────────────────────────────────────────────────────┐\n         │  struct ibv_wc wc;                                 │\n         │  rdma_xport_poll_recv(&wc)  // 轮询 recv_cq       │\n         │                                                    │\n         │  // wc.wr_id 对应 ACK 槽位索引                     │\n         │  slot = wc.wr_id                                   │\n         │  buf_idx = acks[slot].buf_idx  // 从 ACK 消息读取 │\n         │  // 例如：buf_idx = 2                             │\n         └──────────────────────────────────────────────────────┘\n                    │\n                    ▼\nStep Y: 回收缓冲槽到空闲池\n         ┌──────────────────────────────────────────────────────┐\n         │  bp_release(&bp, buf_idx)                          │\n         │  // 将索引 2 放回 free_q                           │\n         │  free_q[tail] = 2                                  │\n         │  tail = (tail + 1) % 8                             │\n         │  count++  // 现在有 1 个空闲槽                    │\n         │                                                    │\n         │  ack_inflight--                                    │\n         └──────────────────────────────────────────────────────┘\n                    │\n                    ▼\nStep Z: 重新投递该 ACK 槽位的 RECV 请求\n         ┌──────────────────────────────────────────────────────┐\n         │  rdma_post_recv(                                  │\n         │      &acks[slot],          // 接收缓冲区          │\n         │      sizeof(struct ack_msg)                       │\n         │  )                                                 │\n         │  // 准备接收下一个 ACK                             │\n         └──────────────────────────────────────────────────────┘\n\n═══════════════════════════════════════════════════════════════════════════════\n                   完整的数据与 ACK 交互时序图\n═══════════════════════════════════════════════════════════════════════════════\n\n时间 →\nMaster    │\n          │  ① 获取空闲槽 idx=2\n          │  ② 序列化数据到本地 MR\n          │  ③ RDMA_WRITE 到 Slave buffer[2] ──────────────────────────►\n          │                                                                                                                 │\n          │                                                                                                                    Slave\n          │                                                                                                                 │\n          │                                                                                                                 │  ④ 收到 WRITE 完成 CQE (含 IMM)\n          │                                                                                                                 │  ⑤ 解析 buffer[2] 数据\n          │                                                                                                                 │  ⑥ 加载到 kvstore\n          │                                                                                                                 │  ⑦ RDMA_SEND(ACK: buf_idx=2) ──►\n          │                                                                                                                 │\n          │  ⑧ 收到 ACK，回收 idx=2 到 free_q                                                                     │\n          │  ⑨ 重新投递 RECV 槽                                                                                      │\n          │                                                                                                                 │\n          │  ⑩ 获取下一个空闲槽（可能是 idx=2，或其他）                                                         │\n          │  ⑪ 继续发送下一批数据 ...                                                                                  │\n          │                                                                                                                 │\n          │  ... 循环直到所有数据发送完毕 ...                                                                           │\n          │                                                                                                                 │\n          │  ⑫ 最后一批：RDMA_WRITE_WITH_IMM(DONE) ─────────────────►       │\n          │                                                                                                                 │\n          │                                                                                                                    Slave\n          │                                                                                                                 │\n          │                                                                                                                 │  ⑬ 收到 DONE，退出循环\n          │                                                                                                                 │  ⑭ rdb_rebuild_all_encodings()\n          │                                                                                                                 │\n          │  ⑮ 等待所有 ACK 回收完毕                                                                                 │\n          │  ⑯ 退出 send_rdb_batches()                                                                             │\n\n═══════════════════════════════════════════════════════════════════════════════\n                   缓冲池状态变化示例（8个缓冲槽）\n═══════════════════════════════════════════════════════════════════════════════\n\n初始状态:\n  free_q = [0,1,2,3,4,5,6,7]  head=0 tail=7 count=8\n  in_flight = []  (无正在使用的槽)\n\n发送第1批 (获取 idx=0):\n  free_q = [1,2,3,4,5,6,7]     head=1 tail=7 count=7\n  in_flight = [0]\n\n发送第2批 (获取 idx=1):\n  free_q = [2,3,4,5,6,7]       head=2 tail=7 count=6\n  in_flight = [0,1]\n\n发送第3批 (获取 idx=2):\n  free_q = [3,4,5,6,7]         head=3 tail=7 count=5\n  in_flight = [0,1,2]\n\n收到 Slave ACK for idx=0 (回收):\n  free_q = [3,4,5,6,7,0]       head=3 tail=0 count=6\n  in_flight = [1,2]\n\n发送第4批 (获取 idx=3):\n  free_q = [4,5,6,7,0]         head=4 tail=0 count=5\n  in_flight = [1,2,3]\n\n... 如此循环，始终保持流水线深度 = 缓冲池大小 (8) ...\n\n全部发送完成，等待所有 ACK 回收:\n  持续轮询直到 in_flight 为空\n  最终 free_q = [0,1,2,3,4,5,6,7] count=8\n\n═══════════════════════════════════════════════════════════════════════════════",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "═══════════════════════════════════════════════════════════════════════════════\n                   数据从 Master → Slave 的完整流动与管理\n═══════════════════════════════════════════════════════════════════════════════\n\n【前提：连接建立与资源交换】\n\nMaster                                          Slave\n  │                                               │\n  │ ① rdma_listen() 监听                         │\n  │                                               │\n  │ ② rdma_get_request() 接受连接                │\n  │  ←─────────── rdma_connect() ─────────────── │\n  │                                               │\n  │ ③ rdma_accept()                              │\n  │  ──────────── rdma_accept() ────────────────►│\n  │                                                                                              │\n  │                                                                                              │ ④ 分配环形缓冲池(8个)\n  │                                                                                              │    bufs[0..7] 每个FULLSYNC_BUF_SIZE\n  │                                                                                              │    注册为 RDMA 可写 MR\n  │                                                                                              │\n  │                                                                                              │ ⑤ 构造 buf_info:\n  │                                                                                              │    num_bufs=8\n  │                                                                                              │    addr[0..7] (本地虚拟地址)\n  │                                                                                              │    rkey[0..7]  (远程访问密钥)\n  │                                                                                              │\n  │  ←─────────── RDMA SEND(buf_info) ─────────── │\n  │                                               │\n  │ ⑥ 保存 Slave 的地址和 rkey 数组              │\n  │                                               │\n  │ ⑦ 注册本地 MR (存放待发送数据)               │\n  │                                               │\n  │ ⑧ 创建 ACK 接收槽 (8个)                     │\n  │    每个槽位接收 struct ack_msg               │\n  │    预投递 RECV 请求                          │\n  │                                               │\n  │ ⑨ 初始化空闲缓冲池: free_q=[0,1,2,3,4,5,6,7]│\n  │                                               │\n\n═══════════════════════════════════════════════════════════════════════════════\n\n【传输循环：数据分批发送与 ACK 流控】\n\n┌─────────────────────────────────────────────────────────────────────────────┐\n│                    Master 侧 send_rdb_batches() 主循环                     │\n└─────────────────────────────────────────────────────────────────────────────┘\n\nStep 1: 检查是否有空闲的 Slave 缓冲槽\n         ┌──────────────────────────────────────┐\n         │  while (bp_empty(&bp) && !rs.exhausted) │\n         │  {                                   │\n         │     等待 Slave 的 ACK 回来           │\n         │     poll_recv_ack() → 回收槽位       │\n         │     bp_release(回收的槽位索引)        │\n         │  }                                   │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep 2: 从空闲池获取一个 Slave 缓冲槽\n         ┌──────────────────────────────────────┐\n         │  buf_idx = bp_acquire(&bp)           │\n         │  例如：buf_idx = 2                   │\n         │  从 free_q 取出，count 减 1          │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep 3: 序列化数据到本地 MR buffer\n         ┌──────────────────────────────────────┐\n         │  dst = 本地 MR buffer 地址           │\n         │  *(uint32_t*)dst = 0  (预留长度槽)   │\n         │  off = 4                             │\n         │                                      │\n         │  if (is_first_batch) {              │\n         │     写入 batch_hdr 到 dst+off        │\n         │     off += sizeof(batch_hdr)        │\n         │     is_first_batch = 0              │\n         │  }                                   │\n         │                                      │\n         │  n = rdb_serialize_next(dst+off)     │\n         │  off += n                            │\n         │                                      │\n         │  *(uint32_t*)dst = htonl(off-4)      │\n         │  // 现在本地 MR buffer 包含:         │\n         │  // [4B长度][batch_hdr][RDB entries] │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep 4: RDMA WRITE 将数据推送到 Slave 的指定缓冲槽\n         ┌──────────────────────────────────────────────────────────────┐\n         │  rdma_xport_write(                                         │\n         │      data = 本地 MR buffer,    // 源地址                  │\n         │      len = off,                // 数据长度                 │\n         │      lkey = 本地 MR 的 lkey,   // 本地访问密钥            │\n         │      remote_addr = binfo.addr[buf_idx], // Slave 地址     │\n         │      rkey = binfo.rkey[buf_idx],       // Slave 密钥      │\n         │      imm_data = batch_done ? DONE : 0   // 立即数信号     │\n         │  )                                                        │\n         │                                                            │\n         │  内部自动按 CHUNK_SIZE 拆分：                              │\n         │  ┌──────────────────────────────────────────────────────┐ │\n         │  │ chunk1: WRITE (无信号)  → 不产生 CQE               │ │\n         │  │ chunk2: WRITE (无信号)  → 不产生 CQE               │ │\n         │  │ ...                                                │ │\n         │  │ chunkN: WRITE_WITH_IMM (有信号) → 产生 CQE         │ │\n         │  │         imm_data 附带在最后一个包中                 │ │\n         │  └──────────────────────────────────────────────────────┘ │\n         └──────────────────────────────────────────────────────────────┘\n                    │\n                    ▼\nStep 5: 更新 Master 状态\n         ┌──────────────────────────────────────┐\n         │  total_bytes += off                  │\n         │  ack_inflight += 1    // 等待ACK+1   │\n         │  nr_batch++                          │\n         │                                      │\n         │  if (batch_done) {                  │\n         │      rs.exhausted = 1               │\n         │      记录传输结束时间                │\n         │  }                                   │\n         └──────────────────────────────────────┘\n\n═══════════════════════════════════════════════════════════════════════════════\n\n【并行：Slave 侧接收与处理】\n\nMaster 的 RDMA WRITE 到达 Slave\n         │\n         ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│                    Slave 侧接收循环                                         │\n└─────────────────────────────────────────────────────────────────────────────┘\n\nStep A: 等待 RDMA WRITE 完成通知\n         ┌──────────────────────────────────────┐\n         │  rdma_xport_poll_recv()              │\n         │  轮询 recv_cq 获得 CQE               │\n         │  从 wc.imm_data 获取立即数           │\n         │  确定是哪个 buffer 被写入 (buf_cur)   │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep B: 读取 Slave buffer 中的数据\n         ┌──────────────────────────────────────┐\n         │  cur = buf_cur                      │\n         │  buf_cur = (buf_cur + 1) % 8        │\n         │                                      │\n         │  // 从 buffer 头部读取长度          │\n         │  data_len = ntohl(*(uint32_t*)bufs[cur])│\n         │  // 数据从 bufs[cur] + 4 开始       │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep C: 解析并加载数据到 kvstore\n         ┌──────────────────────────────────────┐\n         │  load_rdb_batch(bufs[cur]+4, data_len)│\n         │                                      │\n         │  if (is_first) {                    │\n         │     解析 batch_hdr                   │\n         │     保存 repl_offset                 │\n         │     kvs_flush_all() 清空旧数据       │\n         │     rdb_load_stream_begin()          │\n         │     dict_reserve() 预分配哈希表      │\n         │     dict_arena_init() 预分配内存     │\n         │     is_first = 0                     │\n         │  }                                   │\n         │                                      │\n         │  rdb_load_stream_append()            │\n         │  解析每条 RDB 记录并插入 g_dict      │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep D: 发送 ACK 给 Master（释放缓冲槽）\n         ┌──────────────────────────────────────┐\n         │  ack_buf.buf_idx = cur              │\n         │  ack_buf.entries = 本批插入条数      │\n         │                                      │\n         │  rdma_post_send(ACK)                 │\n         │  // 通过 RDMA SEND 发送给 Master    │\n         │                                      │\n         │  等待发送完成                         │\n         └──────────────────────────────────────┘\n                    │\n                    ▼\nStep E: 重新投递该 buffer 的 RECV 请求\n         ┌──────────────────────────────────────┐\n         │  重新 ibv_post_recv()               │\n         │  准备接收下一批数据                  │\n         └──────────────────────────────────────┘\n\n═══════════════════════════════════════════════════════════════════════════════\n\n【Master 侧 ACK 处理与缓冲槽回收】\n\nSlave 的 ACK 到达 Master\n         │\n         ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│                    Master 侧 ACK 处理                                       │\n└─────────────────────────────────────────────────────────────────────────────┘\n\nStep X: poll_recv_ack() 被调用（在 Step 1 的等待循环中）\n         ┌──────────────────────────────────────────────────────┐\n         │  struct ibv_wc wc;                                 │\n         │  rdma_xport_poll_recv(&wc)  // 轮询 recv_cq       │\n         │                                                    │\n         │  // wc.wr_id 对应 ACK 槽位索引                     │\n         │  slot = wc.wr_id                                   │\n         │  buf_idx = acks[slot].buf_idx  // 从 ACK 消息读取 │\n         │  // 例如：buf_idx = 2                             │\n         └──────────────────────────────────────────────────────┘\n                    │\n                    ▼\nStep Y: 回收缓冲槽到空闲池\n         ┌──────────────────────────────────────────────────────┐\n         │  bp_release(&bp, buf_idx)                          │\n         │  // 将索引 2 放回 free_q                           │\n         │  free_q[tail] = 2                                  │\n         │  tail = (tail + 1) % 8                             │\n         │  count++  // 现在有 1 个空闲槽                    │\n         │                                                    │\n         │  ack_inflight--                                    │\n         └──────────────────────────────────────────────────────┘\n                    │\n                    ▼\nStep Z: 重新投递该 ACK 槽位的 RECV 请求\n         ┌──────────────────────────────────────────────────────┐\n         │  rdma_post_recv(                                  │\n         │      &acks[slot],          // 接收缓冲区          │\n         │      sizeof(struct ack_msg)                       │\n         │  )                                                 │\n         │  // 准备接收下一个 ACK                             │\n         └──────────────────────────────────────────────────────┘\n\n═══════════════════════════════════════════════════════════════════════════════\n                   完整的数据与 ACK 交互时序图\n═══════════════════════════════════════════════════════════════════════════════\n\n时间 →\nMaster    │\n          │  ① 获取空闲槽 idx=2\n          │  ② 序列化数据到本地 MR\n          │  ③ RDMA_WRITE 到 Slave buffer[2] ──────────────────────────►\n          │                                                                                                                 │\n          │                                                                                                                    Slave\n          │                                                                                                                 │\n          │                                                                                                                 │  ④ 收到 WRITE 完成 CQE (含 IMM)\n          │                                                                                                                 │  ⑤ 解析 buffer[2] 数据\n          │                                                                                                                 │  ⑥ 加载到 kvstore\n          │                                                                                                                 │  ⑦ RDMA_SEND(ACK: buf_idx=2) ──►\n          │                                                                                                                 │\n          │  ⑧ 收到 ACK，回收 idx=2 到 free_q                                                                     │\n          │  ⑨ 重新投递 RECV 槽                                                                                      │\n          │                                                                                                                 │\n          │  ⑩ 获取下一个空闲槽（可能是 idx=2，或其他）                                                         │\n          │  ⑪ 继续发送下一批数据 ...                                                                                  │\n          │                                                                                                                 │\n          │  ... 循环直到所有数据发送完毕 ...                                                                           │\n          │                                                                                                                 │\n          │  ⑫ 最后一批：RDMA_WRITE_WITH_IMM(DONE) ─────────────────►       │\n          │                                                                                                                 │\n          │                                                                                                                    Slave\n          │                                                                                                                 │\n          │                                                                                                                 │  ⑬ 收到 DONE，退出循环\n          │                                                                                                                 │  ⑭ rdb_rebuild_all_encodings()\n          │                                                                                                                 │\n          │  ⑮ 等待所有 ACK 回收完毕                                                                                 │\n          │  ⑯ 退出 send_rdb_batches()                                                                             │\n\n═══════════════════════════════════════════════════════════════════════════════\n                   缓冲池状态变化示例（8个缓冲槽）\n═══════════════════════════════════════════════════════════════════════════════\n\n初始状态:\n  free_q = [0,1,2,3,4,5,6,7]  head=0 tail=7 count=8\n  in_flight = []  (无正在使用的槽)\n\n发送第1批 (获取 idx=0):\n  free_q = [1,2,3,4,5,6,7]     head=1 tail=7 count=7\n  in_flight = [0]\n\n发送第2批 (获取 idx=1):\n  free_q = [2,3,4,5,6,7]       head=2 tail=7 count=6\n  in_flight = [0,1]\n\n发送第3批 (获取 idx=2):\n  free_q = [3,4,5,6,7]         head=3 tail=7 count=5\n  in_flight = [0,1,2]\n\n收到 Slave ACK for idx=0 (回收):\n  free_q = [3,4,5,6,7,0]       head=3 tail=0 count=6\n  in_flight = [1,2]\n\n发送第4批 (获取 idx=3):\n  free_q = [4,5,6,7,0]         head=4 tail=0 count=5\n  in_flight = [1,2,3]\n\n... 如此循环，始终保持流水线深度 = 缓冲池大小 (8) ...\n\n全部发送完成，等待所有 ACK 回收:\n  持续轮询直到 in_flight 为空\n  最终 free_q = [0,1,2,3,4,5,6,7] count=8\n\n═══════════════════════════════════════════════════════════════════════════════",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cnQmjKxbpaFH4Z3COyh1i",
      "type": "text",
