    {
      "id": "bh_foQ2opYfaXll0vQCcz",
      "type": "text",
      "x": 2697.1907020540343,
      "y": 499.72378394301654,
      "width": 772.819580078125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
