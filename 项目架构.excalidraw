      "seed": 836263470,
      "version": 118,
      "versionNonce": 1549033074,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787465841420,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                        数据落盘三大阶段                                        │\n├─────────────────────────────────────────────────────────────────────────────────┤\n│                                                                                 │\n│  【阶段一】序列化与缓冲（内存中）                                               │\n│  ┌────────────────────────────────────────────────────────────────────────┐     │\n│  │  数据变化：kv_entry_t → RESP 命令串 → 环形缓冲中的字节流              │     │\n│  │  关键操作：memcpy 到 slot（CPU 操作，极快）                           │     │\n│  │  触发条件：每次命令执行后立即执行                                      │     │\n│  │  数据位置：g_ring 环形缓冲（固定 8MB 预分配内存）                     │     │\n│  └────────────────────────────────────────────────────────────────────────┘     │\n│                                     │                                            │\n│                                     │ 阈值(512KB) 或 定时(1秒)                   │\n│                                     ▼                                            │\n│  【阶段二】异步提交（内核队列中）                                               │\n│  ┌────────────────────────────────────────────────────────────────────────┐     │\n│  │  数据变化：slot 中的数据 → io_uring SQE 提交                         │     │\n│  │  关键操作：io_uring_prep_write + io_uring_submit                      │     │\n│  │  触发条件：阈值触发（空间不足）或定时触发（每1秒）                    │     │\n│  │  数据位置：内核 IO 队列 → OS 页缓存                                   │     │\n│  └────────────────────────────────────────────────────────────────────────┘     │\n│                                     │                                            │\n│                                     │ 异步完成                                  │\n│                                     ▼                                            │\n│  【阶段三】持久化（磁盘上）                                                     │\n│  ┌────────────────────────────────────────────────────────────────────────┐     │\n│  │  数据变化：页缓存 → 磁盘扇区                                          │     │\n│  │  关键操作：fdatasync() 或 fsync()                                     │     │\n│  │  触发条件：策略决定（always / everysec / no）                         │     │\n│  │  数据位置：磁盘（持久化）                                              │     │\n│  └────────────────────────────────────────────────────────────────────────┘     │\n│                                                                                 │\n└─────────────────────────────────────────────────────────────────────────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                        数据落盘三大阶段                                        │\n├─────────────────────────────────────────────────────────────────────────────────┤\n│                                                                                 │\n│  【阶段一】序列化与缓冲（内存中）                                               │\n│  ┌────────────────────────────────────────────────────────────────────────┐     │\n│  │  数据变化：kv_entry_t → RESP 命令串 → 环形缓冲中的字节流              │     │\n│  │  关键操作：memcpy 到 slot（CPU 操作，极快）                           │     │\n│  │  触发条件：每次命令执行后立即执行                                      │     │\n│  │  数据位置：g_ring 环形缓冲（固定 8MB 预分配内存）                     │     │\n│  └────────────────────────────────────────────────────────────────────────┘     │\n│                                     │                                            │\n│                                     │ 阈值(512KB) 或 定时(1秒)                   │\n│                                     ▼                                            │\n│  【阶段二】异步提交（内核队列中）                                               │\n│  ┌────────────────────────────────────────────────────────────────────────┐     │\n│  │  数据变化：slot 中的数据 → io_uring SQE 提交                         │     │\n│  │  关键操作：io_uring_prep_write + io_uring_submit                      │     │\n│  │  触发条件：阈值触发（空间不足）或定时触发（每1秒）                    │     │\n│  │  数据位置：内核 IO 队列 → OS 页缓存                                   │     │\n│  └────────────────────────────────────────────────────────────────────────┘     │\n│                                     │                                            │\n│                                     │ 异步完成                                  │\n│                                     ▼                                            │\n│  【阶段三】持久化（磁盘上）                                                     │\n│  ┌────────────────────────────────────────────────────────────────────────┐     │\n│  │  数据变化：页缓存 → 磁盘扇区                                          │     │\n│  │  关键操作：fdatasync() 或 fsync()                                     │     │\n│  │  触发条件：策略决定（always / everysec / no）                         │     │\n│  │  数据位置：磁盘（持久化）                                              │     │\n│  └────────────────────────────────────────────────────────────────────────┘     │\n│                                                                                 │\n└─────────────────────────────────────────────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Bt4rkcSVbadN0L3F9bIH5",
      "type": "text",
      "x": 7032.503912216969,
      "y": -6357.23978723862,
      "width": 1660,
      "height": 2200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA1",
