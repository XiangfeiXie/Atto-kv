      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9n",
      "roundness": null,
      "seed": 1117245490,
      "version": 174,
      "versionNonce": 293712818,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787451219445,
      "link": null,
      "locked": false,
      "text": "═══════════════════════════════════════════════════════════════════════════════════\n                        kv_entry_t 完整内存布局\n═══════════════════════════════════════════════════════════════════════════════════\n\n┌─────────────────────────────────────────────────────────────────────────────┐\n│                          kv_entry_t 结构体头部                              │\n├─────────────────────┬───────────────────────────────────────────────────────┤\n│     字段名          │                    说明                              │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  struct kv_entry_t  │  链表指针 (8 bytes)                                  │\n│  *next              │  指向同一哈希桶中的下一个 Entry                       │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  uint64_t hash      │  64-bit 哈希值 (8 bytes)                            │\n│                     │  FNV-1a + Murmur3 混合哈希                          │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  long long expire   │  过期时间戳 (8 bytes)                               │\n│                     │  毫秒级绝对时间，0 表示永不过期                      │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  uint32_t key_len   │  Key 的长度 (4 bytes)                               │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  uint32_t val_len   │  数据总长度 (4 bytes)                               │\n│                     │  = 2 (type+enc) + payload_len                       │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  char data[]        │  柔性数组 (变长)                                    │\n│                     │  实际存储 type + encoding + key + payload           │\n└─────────────────────┴───────────────────────────────────────────────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "═══════════════════════════════════════════════════════════════════════════════════\n                        kv_entry_t 完整内存布局\n═══════════════════════════════════════════════════════════════════════════════════\n\n┌─────────────────────────────────────────────────────────────────────────────┐\n│                          kv_entry_t 结构体头部                              │\n├─────────────────────┬───────────────────────────────────────────────────────┤\n│     字段名          │                    说明                              │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  struct kv_entry_t  │  链表指针 (8 bytes)                                  │\n│  *next              │  指向同一哈希桶中的下一个 Entry                       │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  uint64_t hash      │  64-bit 哈希值 (8 bytes)                            │\n│                     │  FNV-1a + Murmur3 混合哈希                          │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  long long expire   │  过期时间戳 (8 bytes)                               │\n│                     │  毫秒级绝对时间，0 表示永不过期                      │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  uint32_t key_len   │  Key 的长度 (4 bytes)                               │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  uint32_t val_len   │  数据总长度 (4 bytes)                               │\n│                     │  = 2 (type+enc) + payload_len                       │\n├─────────────────────┼───────────────────────────────────────────────────────┤\n│  char data[]        │  柔性数组 (变长)                                    │\n│                     │  实际存储 type + encoding + key + payload           │\n└─────────────────────┴───────────────────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Vn8MiuvOnAPauRJnB-1Vv",
      "type": "text",
      "x": 6931.200418042537,
      "y": -2936.6222122017566,
      "width": 1580,
      "height": 1100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9o",
      "roundness": null,
      "seed": 537894706,
      "version": 119,
      "versionNonce": 1788428850,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787451216890,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────────────────────────────────────────────┐\n│                        RDB 落盘触发（同步 / 异步）                          │\n│              rdb_save_sync()  或   rdb_save_async_uring()                  │\n└─────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│  ① 扫描全局哈希表（dict）                                                   │\n│     store_scan() → 遍历所有 kv_entry_t                                     │\n└─────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│  ② 序列化为内存缓冲区（rdb_buf_t）                                         │\n│     - 先写 16 字节 Header（magic + version + db_num + key_count）          │\n│     - 对每个 entry：                                                        │\n│       [klen:4][key:klen][dlen:4][data:dlen][expire:8]                      │\n│     - 数据形态：kv_entry_t → 扁平二进制流                                   │\n└─────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│  ③ io_uring 异步写入（rdb_write_uring）                                    │\n│     - 分块（1MB / chunk）                                                   │\n│     - 深度 128 的提交队列                                                   │\n│     - 每个 sqe 写一个 chunk                                                │\n│     - 全部完成后追加 fdatasync（dsync）                                     │\n│     - 写入目标：build/dump.rdb.tmp（临时文件）                              │\n└─────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│  ④ 原子替换（rename）                                                      │\n│     build/dump.rdb.tmp → build/dump.rdb                                   │\n│     （确保不会读到半截文件）                                                │\n└─────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│  ⑤ 更新状态（仅在 BGSAVE 子进程结束后）                                    │\n│     - g_last_save_time = now                                               │\n│     - g_rdb_changes = 0                                                    │\n│     - 记录耗时，用于 cooldown 计算                                          │\n└─────────────────────────────────────────────────────────────────────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────────────────────────────────────────────┐\n│                        RDB 落盘触发（同步 / 异步）                          │\n│              rdb_save_sync()  或   rdb_save_async_uring()                  │\n└─────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│  ① 扫描全局哈希表（dict）                                                   │\n│     store_scan() → 遍历所有 kv_entry_t                                     │\n└─────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│  ② 序列化为内存缓冲区（rdb_buf_t）                                         │\n│     - 先写 16 字节 Header（magic + version + db_num + key_count）          │\n│     - 对每个 entry：                                                        │\n│       [klen:4][key:klen][dlen:4][data:dlen][expire:8]                      │\n│     - 数据形态：kv_entry_t → 扁平二进制流                                   │\n└─────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│  ③ io_uring 异步写入（rdb_write_uring）                                    │\n│     - 分块（1MB / chunk）                                                   │\n│     - 深度 128 的提交队列                                                   │\n│     - 每个 sqe 写一个 chunk                                                │\n│     - 全部完成后追加 fdatasync（dsync）                                     │\n│     - 写入目标：build/dump.rdb.tmp（临时文件）                              │\n└─────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│  ④ 原子替换（rename）                                                      │\n│     build/dump.rdb.tmp → build/dump.rdb                                   │\n│     （确保不会读到半截文件）                                                │\n└─────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n┌─────────────────────────────────────────────────────────────────────────────┐\n│  ⑤ 更新状态（仅在 BGSAVE 子进程结束后）                                    │\n│     - g_last_save_time = now                                               │\n│     - g_rdb_changes = 0                                                    │\n│     - 记录耗时，用于 cooldown 计算                                          │\n└─────────────────────────────────────────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WkjOMeOUvif80Ce9nnggD",
      "type": "text",
      "x": 8951.128330357744,
      "y": -2833.508767580094,
      "width": 1660,
      "height": 975,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9p",
      "roundness": null,
      "seed": 1991980274,
      "version": 1826,
      "versionNonce": 710290418,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787451216890,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                        rdb_save_async_uring() 入口                             │\n│                    （用户/定时器触发 BGSAVE 请求）                              │\n└─────────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n                        ┌─────────────────────────┐\n                        │  Layer 2: Cooldown 检查  │\n                        │  now - g_last_bgsave_   │\n                        │  start < cooldown ?     │\n                        └─────────────────────────┘\n                                                                 │\n                    ┌─────────────────┴─────────────────┐\n                    │ 是                                                                                   │ 否\n                    ▼                                                                                       ▼\n        ┌──────────────────────┐         ┌──────────────────────────────────────┐\n        │  请求被拒绝（-3）                                 │         │  Layer 1: 检查子进程状态             │\n        │  g_bgsave_skipped++                             │         │  g_rdb_child_pid > 0 ?              │\n        │  返回 -3                                             │         └──────────────────────────────────────┘\n        └──────────────────────┘                       │\n                                    ┌─────────────────┴─────────────────┐\n                                    │ 是                                                                                    │ 否\n                                    ▼                                                                                        ▼\n                        ┌────────────────────────┐                               ┌─────────────────────────────┐\n                        │  Layer 3: pending 检查                                 │                              │  ◎ 正常执行 BGSAVE          │\n                        │  g_bgsave_pending ?                                   │                              │                             │\n                        └────────────────────────┘                               │  g_last_bgsave_start = now  │\n                                    │                                                                                  │  g_bgsave_pending = 0       │\n                    ┌───────────────┴───────────────┐                  │  fork()                      │\n                    │ 是                                                                         │ 否               │  ├─ 子进程：rdb_save_sync() │\n                    ▼                                                                              ▼                 │  └─ 父进程：g_rdb_child_pid  │\n        ┌─────────────────────┐  ┌──────────────────┐  │  返回 0                      │\n        │ ① 完全丢弃（-1）                               │  │ ② 合并为 pending                        │  └─────────────────────────────┘\n        │ g_bgsave_skipped++                           │  │   g_bgsave_                              │\n        │ 返回 -1                                            │  │   pending = 1                              │\n        └─────────────────────┘  │   g_bgsave_                              │\n                                                                   │   skipped++      │\n                                                                   │   返回 -2        │\n                                                                   └──────────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                        rdb_save_async_uring() 入口                             │\n│                    （用户/定时器触发 BGSAVE 请求）                              │\n└─────────────────────────────────────────────────────────────────────────────────┘\n                                      │\n                                      ▼\n                        ┌─────────────────────────┐\n                        │  Layer 2: Cooldown 检查  │\n                        │  now - g_last_bgsave_   │\n                        │  start < cooldown ?     │\n                        └─────────────────────────┘\n                                                                 │\n                    ┌─────────────────┴─────────────────┐\n                    │ 是                                                                                   │ 否\n                    ▼                                                                                       ▼\n        ┌──────────────────────┐         ┌──────────────────────────────────────┐\n        │  请求被拒绝（-3）                                 │         │  Layer 1: 检查子进程状态             │\n        │  g_bgsave_skipped++                             │         │  g_rdb_child_pid > 0 ?              │\n        │  返回 -3                                             │         └──────────────────────────────────────┘\n        └──────────────────────┘                       │\n                                    ┌─────────────────┴─────────────────┐\n                                    │ 是                                                                                    │ 否\n                                    ▼                                                                                        ▼\n                        ┌────────────────────────┐                               ┌─────────────────────────────┐\n                        │  Layer 3: pending 检查                                 │                              │  ◎ 正常执行 BGSAVE          │\n                        │  g_bgsave_pending ?                                   │                              │                             │\n                        └────────────────────────┘                               │  g_last_bgsave_start = now  │\n                                    │                                                                                  │  g_bgsave_pending = 0       │\n                    ┌───────────────┴───────────────┐                  │  fork()                      │\n                    │ 是                                                                         │ 否               │  ├─ 子进程：rdb_save_sync() │\n                    ▼                                                                              ▼                 │  └─ 父进程：g_rdb_child_pid  │\n        ┌─────────────────────┐  ┌──────────────────┐  │  返回 0                      │\n        │ ① 完全丢弃（-1）                               │  │ ② 合并为 pending                        │  └─────────────────────────────┘\n        │ g_bgsave_skipped++                           │  │   g_bgsave_                              │\n        │ 返回 -1                                            │  │   pending = 1                              │\n        └─────────────────────┘  │   g_bgsave_                              │\n                                                                   │   skipped++      │\n                                                                   │   返回 -2        │\n                                                                   └──────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DOCYTB4VD1QAqSwJFQu9L",
      "type": "text",
      "x": 11438.380026953204,
      "y": -3208.4070002482786,
      "width": 1660,
      "height": 1650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
