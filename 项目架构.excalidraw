    },
    {
      "id": "H4U85Y1FOpAoByTzSWacA",
      "type": "text",
      "x": 1113.6302863371566,
      "y": 2264.601415262188,
      "width": 526.2997436523438,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8O",
      "roundness": null,
      "seed": 727149086,
      "version": 111,
      "versionNonce": 65403742,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787385982659,
      "link": null,
      "locked": false,
      "text": "ikcp_input()                                           \n\n  1. 解析 KCP Header（conv, cmd, frg, sn, len）   \n  2. memcpy(payload) → kcp->rcv_buf[]  ← 拷贝！     \n  3. 按 sn 排序，按 frg 组装完整消息                   \n  4. 去重（重复的 sn 直接丢弃）                      \n  5. 生成 ACK → 放入 snd_queue                      \n  6. 检测丢包 → 标记重传 ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ikcp_input()                                           \n\n  1. 解析 KCP Header（conv, cmd, frg, sn, len）   \n  2. memcpy(payload) → kcp->rcv_buf[]  ← 拷贝！     \n  3. 按 sn 排序，按 frg 组装完整消息                   \n  4. 去重（重复的 sn 直接丢弃）                      \n  5. 生成 ACK → 放入 snd_queue                      \n  6. 检测丢包 → 标记重传 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
