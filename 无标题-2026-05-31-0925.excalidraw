    {
      "id": "lmnz2zBzeJhk-oWJHal7-",
      "type": "text",
      "x": 7113.3315752248,
      "y": 2969.3965097544587,
      "width": 534.7198486328125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3c",
      "roundness": null,
      "seed": 452386440,
      "version": 299,
      "versionNonce": 1589620360,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780361845516,
      "link": null,
      "locked": false,
      "text": "repl_config 用户态->ebpf：告诉eBPF监听哪个端口\nrepl_sockmap ebpf写入socket,用户态挂载处理程序：\n让内核自动对目标socket执行parser\n\nrepl_ringbuf eBPF->用户态：把捕获的写命令投递给用户态",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "repl_config 用户态->ebpf：告诉eBPF监听哪个端口\nrepl_sockmap ebpf写入socket,用户态挂载处理程序：\n让内核自动对目标socket执行parser\n\nrepl_ringbuf eBPF->用户态：把捕获的写命令投递给用户态",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XmvJUAbSfWCrok-gzV91z",
      "type": "rectangle",
      "x": 4830.358135274091,
