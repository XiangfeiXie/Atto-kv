    {
      "id": "_be5mWX2uE4P_qoBfmP2m",
      "type": "text",
      "x": 4779.603516567815,
      "y": 3862.262393009283,
      "width": 574.5808715820312,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
