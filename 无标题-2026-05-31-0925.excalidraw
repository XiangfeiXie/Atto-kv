    },
    {
      "id": "VFj6JLUQgNKdAO8FZQHDx",
      "type": "text",
      "x": 5768.832951098433,
      "y": 5226.900939520507,
      "width": 659.1599731445312,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3k",
