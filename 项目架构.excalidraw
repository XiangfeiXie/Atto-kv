      "isDeleted": false,
      "boundElements": [],
      "updated": 1787465834874,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                      数据存储层级（从快到慢）                                   │\n├─────────────────────────────────────────────────────────────────────────────────┤\n│                                                                                 │\n│  层级                 │ FSYNC_ALWAYS  │ FSYNC_EVERYSEC │ FSYNC_NO           │\n│───────────────────────┼───────────────┼────────────────┼────────────────────│\n│  ① CPU 缓存          │ 短暂停留     │ 短暂停留       │ 短暂停留           │\n│  ② 内存（环形缓冲）   │ 短暂停留     │ 可停留1秒      │ 可停留很长时间    │\n│  ③ OS 页缓存         │ 短暂停留     │ 停留<1秒       │ 停留到内存压力    │\n│  ④ 磁盘（实际落盘）   │ 立即持久化   │ 1秒内持久化    │ 不保证持久化      │\n│                                                                                 │\n│  红色 = 数据真正落盘后的位置                                                     │\n└─────────────────────────────────────────────────────────────────────────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                      数据存储层级（从快到慢）                                   │\n├─────────────────────────────────────────────────────────────────────────────────┤\n│                                                                                 │\n│  层级                 │ FSYNC_ALWAYS  │ FSYNC_EVERYSEC │ FSYNC_NO           │\n│───────────────────────┼───────────────┼────────────────┼────────────────────│\n│  ① CPU 缓存          │ 短暂停留     │ 短暂停留       │ 短暂停留           │\n│  ② 内存（环形缓冲）   │ 短暂停留     │ 可停留1秒      │ 可停留很长时间    │\n│  ③ OS 页缓存         │ 短暂停留     │ 停留<1秒       │ 停留到内存压力    │\n│  ④ 磁盘（实际落盘）   │ 立即持久化   │ 1秒内持久化    │ 不保证持久化      │\n│                                                                                 │\n│  红色 = 数据真正落盘后的位置                                                     │\n└─────────────────────────────────────────────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9_yXSh6hleUUKDmVqE_4X",
      "type": "text",
      "x": 8700.256830963557,
