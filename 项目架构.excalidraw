    {
      "id": "IvYJUQ5o0np8W4CW2G0zZ",
      "type": "text",
      "x": 2305.9198384184087,
      "y": 3378.871224715391,
      "width": 717.3798217773438,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9M",
      "roundness": null,
      "seed": 1684714462,
      "version": 47,
      "versionNonce": 947902786,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787388237549,
      "link": null,
      "locked": false,
      "text": "ikcp_output(buffer, size)  ← 调用kcp_output_cb            \n  (= send_kcp_datagram)                                              \n                                                                     \n  1. 从 snd_buf 的 Segment 中取 data                                 \n  2. 从 AF_XDP Tx 池获取 UMEM 内存指针                               \n  3. 拷贝 data 到 UMEM Tx 内存（第1次拷贝：KCP → AF_XDP）            \n  4. 预填充的以太网/IP/UDP 头 + 补丁 total-length/校验和               \n  5. 提交到 AF_XDP TX Ring → 网卡发出  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ikcp_output(buffer, size)  ← 调用kcp_output_cb            \n  (= send_kcp_datagram)                                              \n                                                                     \n  1. 从 snd_buf 的 Segment 中取 data                                 \n  2. 从 AF_XDP Tx 池获取 UMEM 内存指针                               \n  3. 拷贝 data 到 UMEM Tx 内存（第1次拷贝：KCP → AF_XDP）            \n  4. 预填充的以太网/IP/UDP 头 + 补丁 total-length/校验和               \n  5. 提交到 AF_XDP TX Ring → 网卡发出  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
