    {
      "id": "q2nn7f7B1utJNB9uaAPfp",
      "type": "text",
      "x": 4862.6006081513215,
      "y": 5471.067166635787,
      "width": 563.7799682617188,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
