      "updated": 1780467043609,
      "link": null,
      "locked": false,
      "text": "typedef struct {\n    shm_slot_t slots[16];  // 16 个槽位\n    uint64_t   base_seq;\n    int        child_should_exit;\n} shm_ring_t;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
