      "versionNonce": 484144809,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780461547052,
      "link": null,
      "locked": false,
      "text": "typedef struct kv_entry_s {\n    struct kv_entry_s *next;    /* chain pointer              (8B) */\n    uint64_t           hash;    /* cached hash                (8B) */\n    long long          expire;  /* expiration timestamp (ms)  (8B) */\n    uint32_t           key_len; /* key length                 (4B) */\n    uint32_t           val_len; /* data[] total size          (4B) */\n    char               data[];  /* [type:1][encoding:1][payload...] */\n} kv_entry_t;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "typedef struct kv_entry_s {\n    struct kv_entry_s *next;    /* chain pointer              (8B) */\n    uint64_t           hash;    /* cached hash                (8B) */\n    long long          expire;  /* expiration timestamp (ms)  (8B) */\n    uint32_t           key_len; /* key length                 (4B) */\n    uint32_t           val_len; /* data[] total size          (4B) */\n    char               data[];  /* [type:1][encoding:1][payload...] */\n} kv_entry_t;",
      "autoResize": true,
      "lineHeight": 1.25
    },
