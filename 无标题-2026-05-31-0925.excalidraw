    {
      "id": "gee2LQVYuCD80ICs_rVyR",
      "type": "text",
      "x": 5517.304396306763,
      "y": 4151.476541077913,
      "width": 614.2198486328125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
