      "seed": 1444462914,
      "version": 55,
      "versionNonce": 521527874,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787388691456,
      "link": null,
      "locked": false,
      "text": "rx_frame_cb() — 剥壳                                              \n                                                                     \n  1. 验证 EtherType == IPv4 (0x0800)                                 \n  2. 验证 UDP 端口 == sync_port                                      \n  3. 剥以太网头(14B) + IP头(20B) + UDP头(8B) = 42B                   \n  4. 拿到 KCP Payload 指针（仍在 UMEM 内存中）                        \n  5. 调用 ikcp_input(t->kcp, payload, plen)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "rx_frame_cb() — 剥壳                                              \n                                                                     \n  1. 验证 EtherType == IPv4 (0x0800)                                 \n  2. 验证 UDP 端口 == sync_port                                      \n  3. 剥以太网头(14B) + IP头(20B) + UDP头(8B) = 42B                   \n  4. 拿到 KCP Payload 指针（仍在 UMEM 内存中）                        \n  5. 调用 ikcp_input(t->kcp, payload, plen)",
      "autoResize": true,
      "lineHeight": 1.25
    },
