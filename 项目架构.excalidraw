      "lineHeight": 1.25
    },
    {
      "id": "5A4fweBFHMPxQq-gnCAuJ",
      "type": "text",
      "x": 2329.6270390144177,
      "y": 2600.2306208028344,
      "width": 455.5071134985169,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
