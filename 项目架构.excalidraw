    {
      "id": "C-INVSMDFmnp4Qe8LjX2N",
      "type": "text",
      "x": 3560.1691254731854,
      "y": 2319.638292967682,
      "width": 680.2598266601562,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
