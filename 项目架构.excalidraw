      "seed": 570126702,
      "version": 1926,
      "versionNonce": 1184202354,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787465833083,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                         完整数据流动路径（内存 → 磁盘）                          │\n└─────────────────────────────────────────────────────────────────────────────────┘\n\n              【阶段1：命令执行】                                        【阶段2：序列化】                                           【阶段3：缓冲】\n  ┌─────────────────┐                 ┌─────────────────┐                ┌─────────────────┐\n  │   kv_entry_t                          │                 │   RESP 命令串                        │                │   环形缓冲                             │\n  │   (内存结构)                            │ ──转换─▶ │   \"*3\\r\\n$3\\r\\n                     │ ──复制─▶│   Slot 0                                │\n  │                                           │                 │    SET\\r\\n...                         │                │   Slot 1                                │\n  │  key: \"foo\"                             │                 │                                          │                │   Slot 2 ...                             │\n  │  value: \"bar\"                            │                │   纯文本协议                           │                │   (16 × 512KB)                        │\n  │  expire: 0                               │                │   (命令 + 数据)                        │                │                                           │\n  └─────────────────┘                 └─────────────────┘                └─────────────────┘\n                                                                                                                                                      │\n                                                                                                                                                      │ 阈值触发\n                                                                                                                                                      │ (剩余空间<4KB)\n                                                                                                                                                      ▼\n  【阶段6：原子替换】                                                     【阶段5：持久化】                                            【阶段4：异步提交】\n  ┌─────────────────┐                    ┌─────────────────┐                    ┌─────────────────┐\n  │  rename(.tmp,                          │ ◀────── │   磁盘文件                              │ ◀────── │   io_uring                              │\n  │      .wal)                                │                   │   incr.wal                                │                   │   SQE 队列                            │\n  │                                           │                   │                                           │                    │   ┌───────────┐       │\n  │  原子操作                               │                   │  偏移地址:                               │                   │   │ 写 Slot 0                │       │\n  │  保证一致性                             │                   │  g_aof_offset                        │                    │   │ 写 Slot 1                │       │\n  └─────────────────┘                    └─────────────────┘                    │   │ 写 Slot 2               │        │\n                                                                                                                                         │   └───────────┘        │\n                                                                                                                                          └─────────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                         完整数据流动路径（内存 → 磁盘）                          │\n└─────────────────────────────────────────────────────────────────────────────────┘\n\n              【阶段1：命令执行】                                        【阶段2：序列化】                                           【阶段3：缓冲】\n  ┌─────────────────┐                 ┌─────────────────┐                ┌─────────────────┐\n  │   kv_entry_t                          │                 │   RESP 命令串                        │                │   环形缓冲                             │\n  │   (内存结构)                            │ ──转换─▶ │   \"*3\\r\\n$3\\r\\n                     │ ──复制─▶│   Slot 0                                │\n  │                                           │                 │    SET\\r\\n...                         │                │   Slot 1                                │\n  │  key: \"foo\"                             │                 │                                          │                │   Slot 2 ...                             │\n  │  value: \"bar\"                            │                │   纯文本协议                           │                │   (16 × 512KB)                        │\n  │  expire: 0                               │                │   (命令 + 数据)                        │                │                                           │\n  └─────────────────┘                 └─────────────────┘                └─────────────────┘\n                                                                                                                                                      │\n                                                                                                                                                      │ 阈值触发\n                                                                                                                                                      │ (剩余空间<4KB)\n                                                                                                                                                      ▼\n  【阶段6：原子替换】                                                     【阶段5：持久化】                                            【阶段4：异步提交】\n  ┌─────────────────┐                    ┌─────────────────┐                    ┌─────────────────┐\n  │  rename(.tmp,                          │ ◀────── │   磁盘文件                              │ ◀────── │   io_uring                              │\n  │      .wal)                                │                   │   incr.wal                                │                   │   SQE 队列                            │\n  │                                           │                   │                                           │                    │   ┌───────────┐       │\n  │  原子操作                               │                   │  偏移地址:                               │                   │   │ 写 Slot 0                │       │\n  │  保证一致性                             │                   │  g_aof_offset                        │                    │   │ 写 Slot 1                │       │\n  └─────────────────┘                    └─────────────────┘                    │   │ 写 Slot 2               │        │\n                                                                                                                                         │   └───────────┘        │\n                                                                                                                                          └─────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ypfEy8LDNcMsgLT3k4nNp",
      "type": "text",
      "x": 10788.28225251266,
      "y": -952.1667936666388,
      "width": 1660,
      "height": 1000,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9s",
      "roundness": null,
      "seed": 1791586734,
      "version": 254,
      "versionNonce": 140303730,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787465839228,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                         策略1：FSYNC_ALWAYS（最安全，最慢）                     │\n├─────────────────────────────────────────────────────────────────────────────────┤\n│                                                                                 │\n│  命令执行 → 写入缓冲 → flush 到磁盘 → 提交 fsync → 等待 fsync 完成 → 返回     │\n│                    │              │              │                              │\n│                    │              │              └─ 每次 flush 都等 fsync     │\n│                    │              └─ 触发：阈值或定时                          │\n│                    └─ 可能还在内存中，未到磁盘                                 │\n│                                                                                 │\n│  数据真正落盘时机：每次 flush 后立即 fsync                                      │\n│  崩溃丢失：最多一条命令                                                         │\n└─────────────────────────────────────────────────────────────────────────────────┘\n\n┌─────────────────────────────────────────────────────────────────────────────────┐\n│                      策略2：FSYNC_EVERYSEC（平衡）                              │\n├─────────────────────────────────────────────────────────────────────────────────┤\n│                                                                                 │\n│  命令执行 → 写入缓冲 → flush 到磁盘 → 缓冲积累 → 每1秒提交 fsync              │\n│                    │              │              │                              │\n│                    │              │              └─ 异步 fsync，不等待        │\n│                    │              └─ 触发：阈值或每1秒定时                    │\n│                    └─ 数据在 OS 页缓存                                         │\n│                                                                                 │\n│  数据真正落盘时机：最晚 1 秒内                                                  │\n│  崩溃丢失：最多 1 秒内的命令                                                    │\n└─────────────────────────────────────────────────────────────────────────────────┘\n\n┌─────────────────────────────────────────────────────────────────────────────────┐\n│                       策略3：FSYNC_NO（最快，最危险）                           │\n├─────────────────────────────────────────────────────────────────────────────────┤\n│                                                                                 │\n│  命令执行 → 写入缓冲 → flush 到磁盘 → 数据停留在 OS 页缓存                     │\n│                    │              │                                             │\n│                    │              └─ 仅写入，不 fsync                          │\n│                    └─ 在 OS 页缓存中                                           │\n│                                                                                 │\n│  数据真正落盘时机：OS 内存压力或系统关闭时                                       │\n│  崩溃丢失：可能丢失大量数据                                                     │\n└─────────────────────────────────────────────────────────────────────────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                         策略1：FSYNC_ALWAYS（最安全，最慢）                     │\n├─────────────────────────────────────────────────────────────────────────────────┤\n│                                                                                 │\n│  命令执行 → 写入缓冲 → flush 到磁盘 → 提交 fsync → 等待 fsync 完成 → 返回     │\n│                    │              │              │                              │\n│                    │              │              └─ 每次 flush 都等 fsync     │\n│                    │              └─ 触发：阈值或定时                          │\n│                    └─ 可能还在内存中，未到磁盘                                 │\n│                                                                                 │\n│  数据真正落盘时机：每次 flush 后立即 fsync                                      │\n│  崩溃丢失：最多一条命令                                                         │\n└─────────────────────────────────────────────────────────────────────────────────┘\n\n┌─────────────────────────────────────────────────────────────────────────────────┐\n│                      策略2：FSYNC_EVERYSEC（平衡）                              │\n├─────────────────────────────────────────────────────────────────────────────────┤\n│                                                                                 │\n│  命令执行 → 写入缓冲 → flush 到磁盘 → 缓冲积累 → 每1秒提交 fsync              │\n│                    │              │              │                              │\n│                    │              │              └─ 异步 fsync，不等待        │\n│                    │              └─ 触发：阈值或每1秒定时                    │\n│                    └─ 数据在 OS 页缓存                                         │\n│                                                                                 │\n│  数据真正落盘时机：最晚 1 秒内                                                  │\n│  崩溃丢失：最多 1 秒内的命令                                                    │\n└─────────────────────────────────────────────────────────────────────────────────┘\n\n┌─────────────────────────────────────────────────────────────────────────────────┐\n│                       策略3：FSYNC_NO（最快，最危险）                           │\n├─────────────────────────────────────────────────────────────────────────────────┤\n│                                                                                 │\n│  命令执行 → 写入缓冲 → flush 到磁盘 → 数据停留在 OS 页缓存                     │\n│                    │              │                                             │\n│                    │              └─ 仅写入，不 fsync                          │\n│                    └─ 在 OS 页缓存中                                           │\n│                                                                                 │\n│  数据真正落盘时机：OS 内存压力或系统关闭时                                       │\n│  崩溃丢失：可能丢失大量数据                                                     │\n└─────────────────────────────────────────────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
