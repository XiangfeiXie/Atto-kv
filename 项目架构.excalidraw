    {
      "id": "MQFB9fUXB8jt5hmchuHny",
      "type": "text",
      "x": 1941.5673111763972,
      "y": 189.77142751078122,
      "width": 423.23980712890625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7b",
      "roundness": null,
      "seed": 375121065,
      "version": 145,
      "versionNonce": 968082953,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787194691725,
      "link": null,
      "locked": false,
      "text": "Step 1: 数据准备 (af_xdp_send_frame)\n① 检查 Tx Free Stack 是否有空闲帧\n    if (tx_free_top == 0) → 回收已完成帧\n② 从 Tx Free Stack 弹出帧地址\n    addr = tx_free[--tx_free_top]\n    addr 范围: [8,388,608, 16,777,152]\n③ 拷贝数据到 UMEM\n    dest = umem_area + addr\n    memcpy(dest, frame, len) ← 一次数据拷贝",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 1: 数据准备 (af_xdp_send_frame)\n① 检查 Tx Free Stack 是否有空闲帧\n    if (tx_free_top == 0) → 回收已完成帧\n② 从 Tx Free Stack 弹出帧地址\n    addr = tx_free[--tx_free_top]\n    addr 范围: [8,388,608, 16,777,152]\n③ 拷贝数据到 UMEM\n    dest = umem_area + addr\n    memcpy(dest, frame, len) ← 一次数据拷贝",
      "autoResize": true,
      "lineHeight": 1.25
    },
