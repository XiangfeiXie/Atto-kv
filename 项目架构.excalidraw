      "isDeleted": false,
      "boundElements": [],
      "updated": 1787454638462,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                         REACTOR 主循环                                         │\n│                                                                                 │\n│   ┌─────────────────────────────────────────────────────────────────────────┐  │\n│   │                          epoll_wait()                                   │  │\n│   │                     返回 nready 个就绪 fd                               │  │\n│   │                                                                         │  │\n│   │  特点：每次都是系统调用，阻塞等待 \"就绪\" 事件                           │  │\n│   └─────────────────────────────────────────────────────────────────────────┘  │\n│                                      │                                         │\n│                                      ▼                                         │\n│                    ┌─────────────────────────────────┐                        │\n│                    │       遍历所有就绪 fd           │                        │\n│                    │       for (i = 0; i < nready)   │                        │\n│                    └─────────────────────────────────┘                        │\n│                                                                                │                                         │\n│          ┌───────────────────────────┼───────────────────────────┐             │\n│          │                                                                    │                                                                    │             │\n│          ▼                                                                    ▼                                                                   ▼             │\n│  ┌───────────────────┐    ┌───────────────────┐    ┌───────────────────┐      │\n│  │   监听 fd                                    │    │   读事件 EPOLLIN                         │    │   写事件 EPOLLOUT │      │\n│  │   (accept)                                   │    │   \"fd 可读了\"                               │    │   \"fd 可写了\"     │      │\n│  └───────────────────┘    └───────────────────┘    └───────────────────┘      │\n│          │                                                                        │                                                    │             │\n│          ▼                                                                        ▼                                                    ▼             │\n│  ┌─────────────────────────────────────────────────────────────────────────┐  │\n│  │                         accept_cb()                                     │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【批处理】while (accept != EAGAIN) {                         │   │  │\n│  │   │      clientfd = accept(listen_fd);  ← 系统调用               │   │  │\n│  │   │      event_register(clientfd);                               │   │  │\n│  │   │  }                                                           │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  └─────────────────────────────────────────────────────────────────────────┘  │\n│                                      │                                         │\n│                                      ▼                                         │\n│  ┌─────────────────────────────────────────────────────────────────────────┐  │\n│  │                         recv_cb()                                       │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【批处理】while (recv != EAGAIN) {                           │   │  │\n│  │   │      n = recv(fd, buf, ...);    ← 系统调用                   │   │  │\n│  │   │      read_buf.len += n;                                      │   │  │\n│  │   │  }                                                           │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  │                              │                                          │  │\n│  │                              ▼                                          │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【批处理】kvs_drain_resp_commands_off()                      │   │  │\n│  │   │  一次解析 read_buf 中所有完整命令 → 生成响应到 write_buf     │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  │                              │                                          │  │\n│  │                              ▼                                          │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【主动 flush】if (write_buf.len > 0) {                       │   │  │\n│  │   │      send_callback(fd);     ← 立即尝试发送                    │   │  │\n│  │   │      send_callback(fd);     ← 第二次 flush 新产生的响应       │   │  │\n│  │   │  }                                                           │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  └─────────────────────────────────────────────────────────────────────────┘  │\n│                                      │                                         │\n│                                      ▼                                         │\n│  ┌─────────────────────────────────────────────────────────────────────────┐  │\n│  │                         send_cb()                                       │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【批处理】while (write_buf.len > 0) {                        │   │  │\n│  │   │      n = send(fd, buf, ...);     ← 系统调用                  │   │  │\n│  │   │      if (n < 0 && errno == EAGAIN) break;                    │   │  │\n│  │   │      write_buf.len -= n;                                     │   │  │\n│  │   │  }                                                           │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  │                              │                                          │  │\n│  │                              ▼                                          │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【动态调整事件掩码】conn_set_events()                        │   │  │\n│  │   │  want = status ? 0 : EPOLLIN;                                │   │  │\n│  │   │  if (write_buf.len > 0) want |= EPOLLOUT;                    │   │  │\n│  │   │  epoll_ctl(EPOLL_CTL_MOD, fd, want);  ← 系统调用             │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  └─────────────────────────────────────────────────────────────────────────┘  │\n│                                                                                 │\n│  ════════════════════════════════════════════════════════════════════════════  │\n│  核心特征：                                                                     │\n│  1. 就绪通知 → 收到 EPOLLIN 才知道要 recv                                      │\n│  2. 串行处理 → recv → 解析 → send 每个阶段完成才继续                          │\n│  3. 主动 flush → 在 recv_cb 结尾立即尝试 2 次 send，减少 epoll 轮次           │\n│  4. 动态 EPOLLOUT → 有数据才加，无数据就移除，避免 LT 风暴                   │\n│  5. 系统调用密集 → epoll_wait + recv + send + epoll_ctl 每轮都要             │\n└─────────────────────────────────────────────────────────────────────────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────────────────────────────────────────────────┐\n│                         REACTOR 主循环                                         │\n│                                                                                 │\n│   ┌─────────────────────────────────────────────────────────────────────────┐  │\n│   │                          epoll_wait()                                   │  │\n│   │                     返回 nready 个就绪 fd                               │  │\n│   │                                                                         │  │\n│   │  特点：每次都是系统调用，阻塞等待 \"就绪\" 事件                           │  │\n│   └─────────────────────────────────────────────────────────────────────────┘  │\n│                                      │                                         │\n│                                      ▼                                         │\n│                    ┌─────────────────────────────────┐                        │\n│                    │       遍历所有就绪 fd           │                        │\n│                    │       for (i = 0; i < nready)   │                        │\n│                    └─────────────────────────────────┘                        │\n│                                                                                │                                         │\n│          ┌───────────────────────────┼───────────────────────────┐             │\n│          │                                                                    │                                                                    │             │\n│          ▼                                                                    ▼                                                                   ▼             │\n│  ┌───────────────────┐    ┌───────────────────┐    ┌───────────────────┐      │\n│  │   监听 fd                                    │    │   读事件 EPOLLIN                         │    │   写事件 EPOLLOUT │      │\n│  │   (accept)                                   │    │   \"fd 可读了\"                               │    │   \"fd 可写了\"     │      │\n│  └───────────────────┘    └───────────────────┘    └───────────────────┘      │\n│          │                                                                        │                                                    │             │\n│          ▼                                                                        ▼                                                    ▼             │\n│  ┌─────────────────────────────────────────────────────────────────────────┐  │\n│  │                         accept_cb()                                     │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【批处理】while (accept != EAGAIN) {                         │   │  │\n│  │   │      clientfd = accept(listen_fd);  ← 系统调用               │   │  │\n│  │   │      event_register(clientfd);                               │   │  │\n│  │   │  }                                                           │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  └─────────────────────────────────────────────────────────────────────────┘  │\n│                                      │                                         │\n│                                      ▼                                         │\n│  ┌─────────────────────────────────────────────────────────────────────────┐  │\n│  │                         recv_cb()                                       │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【批处理】while (recv != EAGAIN) {                           │   │  │\n│  │   │      n = recv(fd, buf, ...);    ← 系统调用                   │   │  │\n│  │   │      read_buf.len += n;                                      │   │  │\n│  │   │  }                                                           │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  │                              │                                          │  │\n│  │                              ▼                                          │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【批处理】kvs_drain_resp_commands_off()                      │   │  │\n│  │   │  一次解析 read_buf 中所有完整命令 → 生成响应到 write_buf     │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  │                              │                                          │  │\n│  │                              ▼                                          │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【主动 flush】if (write_buf.len > 0) {                       │   │  │\n│  │   │      send_callback(fd);     ← 立即尝试发送                    │   │  │\n│  │   │      send_callback(fd);     ← 第二次 flush 新产生的响应       │   │  │\n│  │   │  }                                                           │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  └─────────────────────────────────────────────────────────────────────────┘  │\n│                                      │                                         │\n│                                      ▼                                         │\n│  ┌─────────────────────────────────────────────────────────────────────────┐  │\n│  │                         send_cb()                                       │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【批处理】while (write_buf.len > 0) {                        │   │  │\n│  │   │      n = send(fd, buf, ...);     ← 系统调用                  │   │  │\n│  │   │      if (n < 0 && errno == EAGAIN) break;                    │   │  │\n│  │   │      write_buf.len -= n;                                     │   │  │\n│  │   │  }                                                           │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  │                              │                                          │  │\n│  │                              ▼                                          │  │\n│  │   ┌─────────────────────────────────────────────────────────────────┐   │  │\n│  │   │  【动态调整事件掩码】conn_set_events()                        │   │  │\n│  │   │  want = status ? 0 : EPOLLIN;                                │   │  │\n│  │   │  if (write_buf.len > 0) want |= EPOLLOUT;                    │   │  │\n│  │   │  epoll_ctl(EPOLL_CTL_MOD, fd, want);  ← 系统调用             │   │  │\n│  │   └─────────────────────────────────────────────────────────────────┘   │  │\n│  └─────────────────────────────────────────────────────────────────────────┘  │\n│                                                                                 │\n│  ════════════════════════════════════════════════════════════════════════════  │\n│  核心特征：                                                                     │\n│  1. 就绪通知 → 收到 EPOLLIN 才知道要 recv                                      │\n│  2. 串行处理 → recv → 解析 → send 每个阶段完成才继续                          │\n│  3. 主动 flush → 在 recv_cb 结尾立即尝试 2 次 send，减少 epoll 轮次           │\n│  4. 动态 EPOLLOUT → 有数据才加，无数据就移除，避免 LT 风暴                   │\n│  5. 系统调用密集 → epoll_wait + recv + send + epoll_ctl 每轮都要             │\n└─────────────────────────────────────────────────────────────────────────────────┘",
