      "text": " ikcp_flush() — 四步走：",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " ikcp_flush() — 四步走：",
